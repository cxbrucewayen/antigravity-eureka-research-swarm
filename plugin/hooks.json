{
  "eureka-research-swarm-ownership-guard": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "write_file|edit_file",
        "hooks": [
          {
            "type": "command",
            "command": "node ./hooks/pre-tool-write.mjs",
            "timeout": 8
          }
        ]
      }
    ]
  },
  "eureka-research-swarm-delivery-gate": {
    "enabled": true,
    "Stop": [
      {
        "type": "command",
        "command": "node ./hooks/stop-gate.mjs",
        "timeout": 8
      }
    ]
  }
}
